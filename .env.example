# .env の見本。`.env` にコピーして実値を入れる（.env は Git 管理外）。

# === Django 設定 ===
# 長いランダム文字列。生成例:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change_me_to_a_random_string
# 開発=True / 本番=False（本番は必ず False。HTTPS系セキュリティ設定が有効になる）
DJANGO_DEBUG=True
# このサーバが応答するホスト名（カンマ区切り）。開発=localhost,127.0.0.1 / 本番=独自ドメイン
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 本番(HTTPS)のみ必要。HTTPSドメインからの POST(ログイン等)を許可。https:// を付ける。
# 開発では空でよい。例: https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# === PostgreSQL 接続設定 ===
# 開発=localhost / 本番=RDSのエンドポイント（例: xxxx.ap-northeast-1.rds.amazonaws.com）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=change_me

# === reset_and_seed コマンドが作るテスト用ユーザーのパスワード ===
# 公開リポジトリにハードコードしないよう環境変数に逃がしている。
# ローカル開発用の任意値で良いが、ソースには絶対に書かないこと。
SEED_WORKER1_PASSWORD=change_me
SEED_DEMO_PASSWORD=change_me
